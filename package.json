{
  "name": "listentropy",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server/index.ts & vite --host",
    "dev:frontend": "vite --host",
    "dev:server": "npx tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm build && pnpm deploy:pages:prepare",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build && playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:e2e:ci": "playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:e2e:ci:gate": "playwright test tests/e2e/smoke.spec.ts tests/e2e/upload-errors.spec.ts tests/e2e/universe-eras.spec.ts tests/e2e/responsive.spec.ts tests/e2e/xenolab.spec.ts tests/e2e/a11y.spec.ts --project=chromium",
    "test:e2e:ci:uiux": "playwright test tests/e2e/uiux-audit-primary.spec.ts tests/e2e/uiux-audit-advanced.spec.ts tests/e2e/uiux-audit-responsive-errors.spec.ts --project=chromium",
    "test:e2e:ci:uiux:responsive-errors": "playwright test tests/e2e/uiux-audit-responsive-errors.spec.ts --project=chromium --project=webkit-mobile",
    "test:e2e:matrix": "pnpm build && playwright test -g @matrix --project=chromium --project=webkit-desktop --project=webkit-mobile",
    "test:e2e:a11y": "pnpm build && playwright test -g @a11y --project=chromium",
    "test:e2e:visual": "pnpm build && PW_VISUAL=1 playwright test -g @visual --project=chromium --update-snapshots",
    "check": "pnpm hygiene:fixtures && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm coverage:gate && pnpm build && pnpm perf:budget && pnpm test:e2e",
    "hygiene:snapshot": "node scripts/hygiene/snapshot-baseline.mjs",
    "hygiene:branch-safe": "node scripts/hygiene/check-branch-safety.mjs",
    "hygiene:fixtures": "node scripts/hygiene/check-fixture-policy.mjs",
    "fixtures:generate": "node scripts/hygiene/generate-synthetic-fixture.mjs",
    "test:coverage": "vitest run --coverage",
    "perf:budget": "node scripts/perf/check-budgets.mjs",
    "perf:large-fixture": "node scripts/perf/benchmark-large-fixture.mjs",
    "deploy:pages:prepare": "node scripts/deploy/prepare-github-pages.mjs",
    "coverage:gate": "node scripts/coverage/check-coverage.mjs",
    "audit:real-data": "pnpm build && node scripts/audit/run-real-data-audit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.14",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "d3-force": "^3.0.0",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.552.0",
    "pg": "^8.20.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/typescript-estree>minimatch": "9.0.7",
      "eslint>ajv": "6.14.0",
      "eslint>minimatch": "3.1.4",
      "test-exclude>minimatch": "9.0.7",
      "vite>rollup": "4.59.0"
    }
  }
}
